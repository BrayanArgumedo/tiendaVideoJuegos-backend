# ==============================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================
# Puerto en el que corre la aplicación
# En Railway se usa automáticamente la variable PORT que ellos proveen
PORT=8000

# ==============================================
# CONFIGURACIÓN DE BASE DE DATOS MYSQL
# ==============================================
# Host de la base de datos
# - Para Railway MySQL: usa el host interno que te dan
# - Para PlanetScale: usa el host de la connection string
DB_HOST=localhost

# Usuario de la base de datos
DB_USER=videogames_user

# Contraseña de la base de datos
DB_PASSWORD=tu_password_seguro_aqui

# Nombre de la base de datos
DB_DATABASE=videogames_db

# ==============================================
# CONFIGURACIÓN DE JWT (AUTENTICACIÓN)
# ==============================================
# Clave secreta para firmar los tokens JWT
# IMPORTANTE: Genera una clave segura de al menos 32 caracteres
# Ejemplo: puedes usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_secreto_jwt_muy_largo_y_seguro_cambialo_en_produccion

# Emisor del token (tu dominio o nombre de app)
JWT_ISSUER=gametrade.com

# Audiencia del token (tu aplicación)
JWT_AUDIENCE=gametrade-app

# Tiempo de expiración del token en segundos
# 86400 = 24 horas
# 604800 = 7 días
JWT_EXP_SECONDS=86400

# ==============================================
# CONFIGURACIÓN DE CORS
# ==============================================
# URL de tu frontend (para permitir peticiones CORS)
# En desarrollo: http://localhost:4200
# En producción: https://tu-frontend.vercel.app
FRONTEND_URL=http://localhost:4200

# ==============================================
# CONFIGURACIÓN OPCIONAL (FUTURAS INTEGRACIONES)
# ==============================================
# Para cuando integres Cloudinary (almacenamiento de imágenes)
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

# Para cuando integres servicio de emails
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=tu_api_key
# EMAIL_FROM=noreply@gametrade.com
